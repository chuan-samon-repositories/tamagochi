# Copia esto a `.env`. El .env nunca se commitea.
# Los comentarios van en su propia línea, no al final de un valor.

ANTHROPIC_API_KEY=sk-ant...
BICHO_PORT=8777
BICHO_DB=./brain.db
BICHO_MAX_DOC_CHARS=400000

# Un modelo por tarea. Leer trozo a trozo corre 100 veces por libro: ahí va el
# barato. El repaso y el chat son los que piden criterio.
BICHO_MODEL_STUDY=claude-haiku-4-5
BICHO_MODEL_REVIEW=claude-sonnet-5
BICHO_MODEL_GATE=claude-haiku-4-5
BICHO_MODEL_CHAT=claude-sonnet-5

# Quién puede llamar desde un navegador. En el servidor, el dominio de Vercel.
BICHO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# INFO = una línea por petición. DEBUG añade el log crudo de http.server.
BICHO_LOG_LEVEL=INFO

# --- entorno de pruebas ------------------------------------------------------
# El prefijo `fake/` en cualquiera de los cuatro modelos enruta al proveedor de
# mentira (src/bicho/fake.py): mismas respuestas en forma, cero tokens. Se puede
# mezclar: gate falso y chat de verdad sirve para afinar prompts.CHAT barato.
# Poner los cuatro es lo mismo que arrancar con `bicho --fake`.
#
# BICHO_MODEL_STUDY=fake/mentirijillas
# BICHO_MODEL_REVIEW=fake/mentirijillas
# BICHO_MODEL_GATE=fake/mentirijillas
# BICHO_MODEL_CHAT=fake/mentirijillas

# Lo que tarda cada respuesta falsa. Con 0 estudiar termina antes del primer
# sondeo y los estados `reading` y `sorting` no se ven nunca.
BICHO_FAKE_DELAY_MS=120

# Revienta al leer el trozo N, para probar el rollback. 0 = no falla nunca.
BICHO_FAKE_FAIL_AT=0

# Una pregunta que lleve esta palabra devuelve un 502.
BICHO_FAKE_FAIL_WORD=kaboom
